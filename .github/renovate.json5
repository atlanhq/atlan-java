{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
  ],
  // Keep these PRs out of the generated release notes (see .github/release.yml)
  labels: [
    "dependencies",
  ],
  // Org policy: only adopt versions that have been public for at least 7 days
  // (security fixes for known vulnerabilities bypass this via vulnerabilityAlerts)
  minimumReleaseAge: "7 days",
  internalChecksFilter: "strict",
  prHourlyLimit: 0,
  prConcurrentLimit: 20,
  // The merge queue tests each PR against the latest main, so only rebase when actually conflicted
  // (rebasing a queued PR evicts it from the queue)
  rebaseWhen: "conflicted",
  vulnerabilityAlerts: {
    labels: [
      "dependencies",
      "security",
    ],
    minimumReleaseAge: null,
  },
  packageRules: [
    {
      // Enable GitHub auto-merge on non-major updates, so they enter the merge queue
      // as soon as checks pass and a code owner approves
      matchUpdateTypes: [
        "minor",
        "patch",
        "pin",
        "digest",
      ],
      automerge: true,
    },
    {
      // shadow >= 9.5.0 requires Gradle 9; remove this rule once the Gradle wrapper is on 9.x
      matchPackageNames: [
        "com.gradleup.shadow",
        "com.gradleup.shadow:com.gradleup.shadow.gradle.plugin",
      ],
      allowedVersions: "<9.5.0",
    },
    {
      // AWS SDK's netty-nio-client still requests the 4.1.x line of netty-codec (netty41 in libs.versions.toml)
      matchPackageNames: [
        "io.netty:netty-codec",
      ],
      allowedVersions: "<4.2.0",
    },
    {
      // wiremock-jetty12 brings in the jetty 12.0.x line for these modules (wiremock-jetty in libs.versions.toml)
      matchPackageNames: [
        "org.eclipse.jetty:jetty-security",
        "org.eclipse.jetty:jetty-client",
        "org.eclipse.jetty.ee10:jetty-ee10-servlet",
      ],
      allowedVersions: "<12.1.0",
    },
    {
      // Each instrumentation BOM release imports a specific opentelemetry-bom version, so update
      // both together and have a human confirm they line up before merging
      matchPackageNames: [
        "io.opentelemetry:opentelemetry-bom",
        "io.opentelemetry.instrumentation:opentelemetry-instrumentation-bom-alpha",
      ],
      groupName: "opentelemetry",
      automerge: false,
      prBodyNotes: [
        "⚠️ `otel` must match the `opentelemetry-bom` version imported by the new `opentelemetry-instrumentation-bom-alpha` POM on Maven Central. Adjust `otel` in `gradle/libs.versions.toml` before merging if they differ.",
      ],
    },
  ],
}
